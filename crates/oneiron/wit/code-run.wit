package oneiron:code-run@1.0.0;

// The guest authoring language remains plain JavaScript. These imports are the
// typed host ABI, not an additional authoring surface. @js names are consumed
// by the SDK/declaration generator. JSON fields carry values from the existing
// SelfCall ABI; the host still performs the normal per-operation admission.
world guest {
    record time-range { start: u64, end: u64 }
    record claim-input {
        id: string,
        predicate: string,
        // @json
        subject: string,
        // @json
        value: string,
        confidence: option<f32>,
        occurred: option<time-range>,
        learned-at: option<u64>,
    }
    record wait-output { wait-id: string }
    record speech-output { order: u32, is-visible: bool }
    record blocked-output { receipt: string }
    record agent-put-input {
        id: string,
        // @json
        definition: string,
    }
    record agent-put-output { id: string, disposition: string }
    record prompt-input { prompt: string }
    record text-input { text: string }
    record credential-input {
        operation: string,
        credential-handle: string,
        // @json
        args: string,
    }
    record file-delete-proposal { path: string }
    record file-rename-proposal { origin: string, destination: string }
    // A proposed file's bytes never ride in the step result: they stream
    // through the proposal imports below.
    variant proposal-delta {
        claim-candidate(claim-input),
        file-delete(file-delete-proposal),
        file-rename(file-rename-proposal),
    }
    record step-result {
        result-json: string,
        proposals: list<proposal-delta>,
    }

    // @js sandbox.fs.read_file
    import read-file: func(path: string) -> result<list<u8>, string>;
    // @js sandbox.credential.call
    import credential-call: func(input: credential-input) -> result<string, string>;
    // @js oneiron.clock.now_unix_ms
    import clock-now-unix-ms: func() -> u64;
    // @js oneiron.random.bytes
    import random-bytes: func(length: u32) -> result<list<u8>, string>;
    // The step's result, streamed as it is written: bootstrap's own wiring
    // behind console.log, finish and writeOutput, so no result is ever held
    // whole in the guest. A text frame goes to "console" or "finish"; `start`
    // marks a value's first frame, so a second finish replaces the first. A
    // byte frame appends to its /mnt/outputs file. Each frame fits one
    // message; the reply is the frame's byte count as stored.
    // @js oneiron.output.text @abi
    import output-text: func(target: string, start: bool, frame: string) -> result<u64, string>;
    // @js oneiron.output.bytes @abi
    import output-bytes: func(path: string, frame: list<u8>) -> result<u64, string>;
    // A proposed file, streamed: bootstrap's own wiring behind propose.file.
    // `proposal-open` names the file and returns its id, `proposal-chunk`
    // appends one frame of at most one message, and `proposal-close` settles
    // it, replying with its byte count. One file is open at a time; the guest
    // never holds a file whole, and a file has no size bound. Foreign-only:
    // the first-party build links none of the three.
    // @js oneiron.propose.open @abi
    import proposal-open: func(path: string) -> result<u64, string>;
    // @js oneiron.propose.chunk @abi
    import proposal-chunk: func(proposal: u64, frame: list<u8>) -> result<u64, string>;
    // @js oneiron.propose.close @abi
    import proposal-close: func(proposal: u64) -> result<u64, string>;

    // First-party-only imports. Foreign components must not import these;
    // their writes are exported as proposals and never linked as host effects.
    // @js vault.agents.put
    import agents-put: func(input: agent-put-input) -> result<agent-put-output, string>;
    // @js self.json.validate
    import json-validate: func(
        // @json
        schema: string,
        // @json
        value: string
    ) -> result<bool, string>;
    // The SDK verb table, served from the host's generated catalog, and one
    // call of any verb in it. Bootstrap builds `self.memory.<verb>` from these
    // two, so a verb row reaches the guest with no component rebuild. The
    // memory reads and writes the run answers itself are rows too.
    // @js self.verbs.names @sync @abi
    import verb-names: func() -> result<list<string>, string>;
    // @js self.verbs.call @abi
    import verb-call: func(
        verb: string,
        // @json
        input: string
    ) -> result<string, string>;
    // @js self.report_blocked
    import report-blocked: func(category: string, detail: string) -> result<blocked-output, string>;
    // @js ask
    import ask: func(input: prompt-input) -> result<wait-output, string>;
    // @js self.speak
    import speak: func(input: text-input) -> result<speech-output, string>;
    // @js self.think
    import think: func(input: text-input) -> result<speech-output, string>;
    // @js self.express
    import express: func(input: text-input) -> result<speech-output, string>;

    export run-step: func(source: string) -> result<step-result, string>;
}
