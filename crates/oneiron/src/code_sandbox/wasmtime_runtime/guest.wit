package oneiron:code-run@1.0.0;

// Payloads are strict per-function JSON (wire.rs), not arbitrary dispatch.
// Entity ids use hex strings. Edge kind uses its snake_case registry name. Guest writes
// cannot name actor, source, provenance or approval. The host supplies those.
world guest {
    import fs-read-file: func(input: string) -> string;
    import credential-call: func(input: string) -> string;
    import clock-now-unix-ms: func(input: string) -> string;
    import random-bytes: func(input: string) -> string;
    import memory-search: func(input: string) -> string;
    import memory-put-claim: func(input: string) -> string;
    import memory-supersede-claim: func(input: string) -> string;
    import memory-put-edge: func(input: string) -> string;
    import ask-human: func(input: string) -> string;
    import ask-human-camel: func(input: string) -> string;
    import speak: func(input: string) -> string;
    import think: func(input: string) -> string;
    import express: func(input: string) -> string;
    export run: func(script: string) -> string;
}
