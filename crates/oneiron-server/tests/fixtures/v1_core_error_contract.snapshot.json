            "field": "ref"
          },
          "suggestions": [
            "Fix the request shape and retry."
          ]
        }
      }
    }
  },
  {
    "name": "missing_auth",
    "request": {
      "method": "GET",
      "path": "/v1/core/turns/annotate?turn_id=not-an-entity",
      "auth": {
        "type": "none"
      },
      "body": null
    },
    "response": {
      "status": 401,
      "body": {
        "error": {
          "code": "UNAUTHORIZED",
          "message": "request is not authorized",
          "requestId": "<request-id>",
          "details": {
            "code": "UNAUTHORIZED"
          },
          "suggestions": [
            "Send the configured x-oneiron-secret header and retry."
          ]
        }
      }
    }
  },
  {
    "name": "wrong_scope",
    "request": {
      "method": "GET",
      "path": "/v1/core/turns/annotate?turn_id=not-an-entity",
      "auth": {
        "type": "bearer",
