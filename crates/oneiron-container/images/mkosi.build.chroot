#!/bin/bash
# Builds the plan's native binaries inside the image's own pinned userspace:
# mkosi runs this chrooted into the image plus its build overlay (the
# BuildPackages compilers from the same frozen snapshot), so every binary
# links against the glibc it ships with. No host build and no ldd check.
#
# Mounted by build.py under /work/src: engine/ (git archive of
# inputs.engine.commit), rust/ (the pinned Rust dist components), cargo-home/
# (the mirror's clean CARGO_HOME), plan/ (native.tsv, sources.tsv), and per
# external source build <pin>: source-<pin>/ (its pinned archive's extract),
# rust-<pin>/ (the toolchain it pins) and cargo-home-<pin>/ (its own store).
# Sources are ephemeral: writes land in an overlay mkosi discards. Network is
# off (and the whole build runs in a namespace with none).
set -euo pipefail

if [ "${ONEIRON_IMAGES_PHASE:-}" = fetch ]; then
  echo "fetch phase: packages are cached, nothing is built"
  exit 0
fi

src=/work/src
plan=$src/plan/native.tsv
sources=$src/plan/sources.tsv
: "${SOURCE_DATE_EPOCH:?mkosi sets SOURCE_DATE_EPOCH from release.toml}"
: "${BUILDDIR:?build.py configures BuildDirectory}"
if [ ! -s "$plan" ] && [ ! -s "$sources" ]; then
  echo "no native targets in this plan"
  exit 0
fi

unset RUSTUP_TOOLCHAIN RUSTC_WRAPPER CARGO_BUILD_RUSTC_WRAPPER RUSTFLAGS CARGO_ENCODED_RUSTFLAGS
record="$BUILDDIR/native-record.tsv"
: > "$record"

if [ -s "$plan" ]; then
  export PATH="$src/rust/bin:/usr/bin:/bin"
  export CARGO_HOME="$src/cargo-home"
  export CARGO_TARGET_DIR="$BUILDDIR/target"
  export CARGO_NET_OFFLINE=true CARGO_INCREMENTAL=0 CARGO_TERM_COLOR=never
  # No build-machine path survives in the binaries: sources, the Cargo home,
  # the toolchain and the target dir (build-script output) map to fixed names.
  export RUSTFLAGS="--remap-path-prefix=$src/engine=/oneiron --remap-path-prefix=$CARGO_HOME=/cargo-home --remap-path-prefix=$src/rust=/rust --remap-path-prefix=$CARGO_TARGET_DIR=/target"
  # The C and C++ that build scripts compile (cc, cmake) map the same paths:
  # a crate's C source keeps its assertions' __FILE__ (tree-sitter defines no
  # NDEBUG), and the Rust remap does not reach a C compiler.
  cmap="-ffile-prefix-map=$src/engine=/oneiron -ffile-prefix-map=$CARGO_HOME=/cargo-home -ffile-prefix-map=$CARGO_TARGET_DIR=/target"
  export CFLAGS="$cmap" CXXFLAGS="$cmap"

  printf 'rustc\t%s\n' "$(rustc -V)" >> "$record"
  printf 'cargo\t%s\n' "$(cargo -V)" >> "$record"
  rustc -vV

  # One cargo invocation per package, its bins together, in plan order: the
  # same feature unification the old build.sh recipes had.
  declare -A seen=()
  order=()
  declare -A bins=()
  while IFS=$'\t' read -r package bin dest mode; do
    if [ -z "${seen[$package]:-}" ]; then
      seen[$package]=1
      order+=("$package")
    fi
    bins[$package]="${bins[$package]:-} --bin $bin"
  done < "$plan"

  cd "$src/engine"
  for package in "${order[@]}"; do
    # Without mkosi's DESTDIR: a build script's install step (CMake honours
    # $DESTDIR) would put its output in the image, not where Cargo links it.
    # shellcheck disable=SC2086
    env -u DESTDIR cargo build --release --locked --offline -p "$package" ${bins[$package]}
  done

  # The SBOM's Cargo side, with the features this build resolved: the crates
  # each package's binaries link (normal edges) and the crates its build also
  # compiled (normal plus build edges). Same lock, same store, offline.
  for package in "${order[@]}"; do
    for edges in normal normal,build; do
      out="$BUILDDIR/sbom-cargo-$package-${edges/,/+}.txt"
      # A failure here leaves no file: the SBOM step then refuses, after the image is built.
      cargo tree --locked --offline -p "$package" --target x86_64-unknown-linux-gnu -e "$edges" \
        --prefix none --format '{p}|{l}' > "$out.part" && mv "$out.part" "$out" \
        || echo "cargo tree -p $package -e $edges failed" >&2
    done
  done

  while IFS=$'\t' read -r package bin dest mode; do
    install -D -m "$mode" "$CARGO_TARGET_DIR/release/$bin" "$DESTDIR$dest"
    sum=$(sha256sum "$DESTDIR$dest" | cut -d' ' -f1)
    printf 'bin\t%s\t%s\n' "$dest" "$sum" >> "$record"
  done < "$plan"
fi

# External source builds (packages.toml source_builds): each with its own
# pinned toolchain and its own store, in a clean environment (env -i: no
# variable of the engine build or of mkosi reaches it but the ones named
# here), default features, offline. Rust and C paths of the source, the store,
# the toolchain and the target dir map to fixed names; build_env (release.toml)
# supplies what its build scripts would otherwise ask git for.
if [ -s "$sources" ]; then
  while IFS=$'\t' read -r pin workdir package bin dest mode build_env; do
    tree=$src/source-$pin
    home=$src/cargo-home-$pin
    rust=$src/rust-$pin
    target=$BUILDDIR/target-$pin
    remap="--remap-path-prefix=$tree=/$pin --remap-path-prefix=$home=/cargo-home --remap-path-prefix=$rust=/rust --remap-path-prefix=$target=/target"
    cmap="-ffile-prefix-map=$tree=/$pin -ffile-prefix-map=$home=/cargo-home -ffile-prefix-map=$target=/target"
    extra=()
    [ "$build_env" = - ] || read -r -a extra <<< "$build_env"
    clean=(env -i "PATH=$rust/bin:/usr/bin:/bin" "HOME=/nonexistent" "LC_ALL=C.UTF-8" "TZ=UTC"
           "SOURCE_DATE_EPOCH=$SOURCE_DATE_EPOCH" "CARGO_HOME=$home" "CARGO_TARGET_DIR=$target"
           "CARGO_NET_OFFLINE=true" "CARGO_INCREMENTAL=0" "CARGO_TERM_COLOR=never"
           "RUSTFLAGS=$remap" "CFLAGS=$cmap" "CXXFLAGS=$cmap" "${extra[@]}")
    printf 'rustc-%s\t%s\n' "$pin" "$("${clean[@]}" rustc -V)" >> "$record"
    printf 'cargo-%s\t%s\n' "$pin" "$("${clean[@]}" cargo -V)" >> "$record"
    cd "$tree/$workdir"
    "${clean[@]}" cargo build --release --locked --offline -p "$package" --bin "$bin"
    for edges in normal normal,build; do
      out="$BUILDDIR/sbom-source-$pin-${edges/,/+}.txt"
      "${clean[@]}" cargo tree --locked --offline -p "$package" --target x86_64-unknown-linux-gnu -e "$edges" \
        --prefix none --format '{p}|{l}' > "$out.part" && mv "$out.part" "$out" \
        || echo "cargo tree -p $package -e $edges ($pin) failed" >&2
    done
    install -D -m "$mode" "$target/release/$bin" "$DESTDIR$dest"
    sum=$(sha256sum "$DESTDIR$dest" | cut -d' ' -f1)
    printf 'bin\t%s\t%s\n' "$dest" "$sum" >> "$record"
  done < "$sources"
fi
cat "$record"
