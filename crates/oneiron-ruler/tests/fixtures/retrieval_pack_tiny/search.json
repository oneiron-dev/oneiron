    {
      "record_id": "tiny-r03",
      "kind": "turn",
      "speaker": "user",
      "text": "Owen prefers the quiet street near the park.",
      "source_ref": "tiny-s1#2"
    },
    {
      "record_id": "tiny-r04",
      "kind": "turn",
      "speaker": "assistant",
      "text": "Yuki started a new job at the city library.",
