{
  "name": "vault.notes.fork",
  "description": "Forks one NOTE at the exact live-head version the caller read, retaining its edits or rewrite without moving the live head.",
  "input": "crate::note::NoteForkRequest",
  "output": "crate::note::NoteForkView",
  "call": "memory.fork_note(&input)?",
  "scope": "Write",
  "admission": {
    "unrestricted_record_scope": true,
    "readable": [
      "note_ref"
    ]
  },
  "mcp_scope": "unrestricted",
  "section": false,
  "binding": {
    "native": "agent_verb",
    "request": true
  },
  "openapi": true,
  "refs": [
    "/note_ref"
  ],
  "prose_links": [
    "/edit/text"
  ]
}
