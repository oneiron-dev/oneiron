{
  "name": "vault.repo.proposal_submit",
  "description": "Keeps one whole-file change against the attached run's own work as an immutable Proposed proposal under the vault's review policy and a host-witnessed provenance; without that witness it holds typed, work kept.",
  "input": "crate::task_verb::sdk::LiveRunRequest<crate::memory::repo_doors::RepoProposalSubmitInput>",
  "output": "crate::memory::repo_doors::RepoProposalSubmitOutput",
  "call": "crate::task_verb::sdk::host_only(memory, \"vault.repo.proposal_submit\", &input)?",
  "scope": "Write",
  "act_class": "unstated",
  "admission": {
    "lane_record_scope": true,
    "require_granted_scope": true
  },
  "mcp_scope": "filtered",
  "section": false,
  "host_door": true,
  "host_door_precheck": false,
  "host_door_lists": true,
  "host_door_caller": true,
  "host_door_session": true,
  "openapi": true
}
