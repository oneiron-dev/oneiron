{
  "name": "tasks.answer",
  "description": "Admits one person's word on an ask; the word is evidence, never approval.",
  "refs": [
    "/word/provenance_refs/*/claim",
    "/word/provenance_refs/*/turn"
  ],
  "refs_check": "crate::task_verb::admit_ask_references",
  "input": "crate::task_verb::sdk::TaskAnswerRequest",
  "output": "crate::task_verb::TaskAskAnswer",
  "mcp_served": "[input.handle.group_ref]",
  "call": "memory.tasks_answer(&input.handle, &input.word)?",
  "scope": "Write",
  "act_class": "unstated",
  "task_work": true,
  "mcp_fields": {
    "spec": "$"
  },
  "mcp_scope": "unrestricted",
  "section": true,
  "binding": {
    "generic": true,
    "args": [
      {
        "name": "handle",
        "type": "crate::task_verb::TaskAskHandle"
      },
      {
        "name": "word",
        "type": "crate::task_verb::TaskAskWord"
      }
    ]
  }
}
