{
  "name": "tasks.update",
  "description": "Reports task progress, blocked work or a durable result through the task highway; without a report, acknowledges a failed TASK. A revised workflow binding reaches only later tries.",
  "refs": [
    "/task_ref"
  ],
  "input": "TaskUpdateRequest",
  "output": "crate::task_verb::TaskUpdateReceipt",
  "outputs_by_input": {
    "resultRef": "crate::code_run::ReaderReportReceipt"
  },
  "mcp_served": "oneiron::EntityId::from_hex(&input.task_ref).ok()",
  "call": "memory.tasks_update_request(&input)?",
  "scope": "Write",
  "task_decisions": true,
  "mcp_scope": "addressed",
  "mcp_fields": {
    "spec": "$",
    "task_ref": "=task_ref"
  },
  "admission": {
    "unrestricted_record_scope": true,
    "readable": [
      "task_ref"
    ]
  },
  "section": true
}
