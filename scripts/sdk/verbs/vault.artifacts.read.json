{
  "name": "vault.artifacts.read",
  "description": "Reads one version of a blob artifact's bytes.",
  "uniffi": {
    "args": {
      "artifact_ref": "String",
      "version": "u64"
    },
    "output": "Option<Vec<u8>>"
  },
  "input": "ReadBlobVersionRequest",
  "output": "Option<crate::task_verb::sdk::BlobContent>",
  "call": "memory_requests::read_blob(memory, input)?",
  "scope": "Read",
  "admission": {
    "unrestricted_record_scope": true,
    "readable": [
      "artifact_ref"
    ]
  },
  "section": false,
  "binding": {
    "native": "agent_verb",
    "request": true
  }
}
