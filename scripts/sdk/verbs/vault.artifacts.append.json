{
  "name": "vault.artifacts.append",
  "description": "Appends a checked blob version: landed on the chain, or proposed beside the live artifact for Keep.",
  "uniffi": {
    "args": {
      "artifact_ref": "String",
      "content": "Vec<u8>",
      "run_ref": "Option<String>",
      "occurred_at": "Option<i64>",
      "learned_at": "Option<i64>"
    },
    "output": "BlobVersionAppendOutcome"
  },
  "input": "AppendBlobVersionRequest",
  "output": "crate::memory::BlobVersionAppendOutcome",
  "call": "memory_requests::append_blob(memory, input)?",
  "file_call": "memory_requests::append_blob_file(memory, input, body)?",
  "scope": "Write",
  "act_class": "reversible_work",
  "admission": {
    "unrestricted_record_scope": true,
    "readable": [
      "artifact_ref"
    ]
  },
  "section": false,
  "binding": {
    "native": "agent_verb",
    "request": true
  }
}
