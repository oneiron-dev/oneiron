  "input": "crate::note::NoteProposalOpenRequest",
  "output": "crate::note::NoteProposalView",
  "call": "memory.open_note_proposal(&input)?",
  "scope": "Write",
  "act_class": "unstated",
  "admission": {
    "unrestricted_record_scope": true
  },
  "mcp_scope": "unrestricted",
  "section": false,
  "binding": {
    "native": "agent_verb",
    "request": true
  },
  "openapi": true,
  "refs": [
    "/forks/*/note_ref"
  ],
  "prose_links": [
    "/explainer"
  ]
}
