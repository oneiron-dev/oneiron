{
  "name": "vault.neighbors",
  "description": "The weighted-edge neighbourhood of one entity, filtered by edge kind and minimum weight.",
  "uniffi": {
    "args": {
      "entity_ref": "String",
      "opts": "NeighborOpts"
    },
    "output": "NeighborHits"
  },
  "input": "NeighborsRequest",
  "output": "crate::claim::ScopedReadResult<Vec<crate::memory::NeighborHit>>",
  "call": "memory.with_read_filter(input.filter.as_ref()).neighbors(&input.entity_ref, &input.opts)?",
  "scope": "Read",
  "act_class": "read",
  "admission": {
    "lane_record_scope": true,
    "validate": "crate::memory::caps::check_limit_nonzero(input.opts.limit)?;"
  },
  "section": false,
  "binding": {
    "native": "agent_verb",
    "request": true
  },
  "mcp_scope": "filtered"
}
