{
  "name": "vault.hydrate",
  "description": "Returns the found records for short refs or hex ids, the read's receipt, and a list of the refs it did not find.",
  "example": "await vault.hydrate({ refs: items.map(i => i.short_id) });",
  "uniffi": {
    "args": {
      "refs": "Vec<String>"
    },
    "output": "EntityViews"
  },
  "input": "HydrateRequest",
  "output": "crate::memory::HydrateResult",
  "call": "memory.with_read_filter(input.filter.as_ref()).hydrate_found(&input.refs)?",
  "scope": "Read",
  "act_class": "read",
  "admission": {
    "lane_record_scope": true
  },
  "section": false,
  "binding": {
    "native": "agent_verb",
    "request": true
  },
  "mcp_scope": "filtered",
  "session_read": "Hydrate"
}
