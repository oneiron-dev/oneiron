    },
    "output": "EntityRefReceipt"
  },
  "input": "crate::memory::HabitCheckinInput",
  "output": "crate::memory::EntityRefReceipt",
  "call": "memory.put_habit_checkin(&input)?",
  "scope": "Write",
  "admission": {
    "unrestricted_record_scope": true
  },
  "section": false,
  "binding": {
    "native": "agent_verb",
    "request": true
  }
}
