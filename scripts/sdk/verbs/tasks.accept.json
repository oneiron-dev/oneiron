  "call": "memory.tasks_accept(input)?",
  "scope": "Write",
  "act_class": "reversible_work",
  "mcp_scope": "addressed",
  "mcp_fields": {
    "spec": "$",
    "task_ref": "=task_ref"
  },
  "admission": {
    "unrestricted_record_scope": true,
    "readable": [
      "task_ref"
    ]
  },
  "section": true
}
