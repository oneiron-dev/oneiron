{
  "name": "vault.notes.edit",
  "description": "Edits one NOTE in a transaction-local document; a rejected edit leaves nothing pending.",
  "refs": [
    "/note_ref"
  ],
  "prose_links": [
    "/edit/text"
  ],
  "input": "EditNoteRequest",
  "output": "crate::note::NoteProgramEditOutcome",
  "call": "memory.edit_note(&input.note_ref, &input.edit)?",
  "scope": "Write",
  "admission": {
    "unrestricted_record_scope": true,
    "readable": [
      "note_ref"
    ]
  },
  "binding": {
    "native": "agent_verb",
    "request": true
  },
  "section": false
}
