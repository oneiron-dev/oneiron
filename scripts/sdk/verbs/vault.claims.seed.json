{
  "name": "vault.claims.seed",
  "description": "Seeds claims through their individual gates, forced proposed, returning per claim its landed receipt or its typed refusal and refusal receipt.",
  "refs": [
    "/claims/*/subject_ref",
    "/claims/*/evidence_turn_refs/*"
  ],
  "input": "crate::memory::ScopedCommitRequest",
  "output": "Vec<crate::memory::CommitOutcome>",
  "call": "memory.commit_scoped(&input.claims, true)?",
  "scope": "Write",
  "act_class": "reversible_work",
  "admission": {
    "claim_record_scope": true
  },
  "section": false,
  "binding": {
    "native": "agent_verb",
    "request": true
  },
  "proposes": true,
  "mcp_fields": {
    "spec": "$"
  },
  "mcp_scope": "filtered"
}
