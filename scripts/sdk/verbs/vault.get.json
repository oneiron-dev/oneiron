{
  "name": "vault.get",
  "description": "Reads one entity as a typed view, or none when absent or withheld; the receipt says which.",
  "uniffi": {
    "args": {
      "entity_ref": "String"
    },
    "output": "EntityRead"
  },
  "input": "EntityRequest",
  "output": "crate::claim::ScopedReadResult<Option<crate::memory::EntityView>>",
  "call": "memory.with_read_filter(input.filter.as_ref()).get_entity(&input.entity_ref)?",
  "scope": "Read",
  "admission": {
    "lane_record_scope": true
  },
  "section": false,
  "binding": {
    "native": "agent_verb",
    "request": true
  },
  "mcp_scope": "filtered",
  "session_read": "Get"
}
