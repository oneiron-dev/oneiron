          {
            "name": "effort",
            "kind": "effort",
            "default": "medium"
          },
          {
            "name": "scope",
            "kind": "scope"
          },
          {
            "name": "limit",
            "kind": "limit",
            "default": 10
          },
          {
            "name": "format",
            "kind": "format"
          }
        ],
        "docs": {
          "remote": "    /// Recalls a memory pack.\n    ///\n    /// The lease argument the engine takes is `None` and is NOT a client\n    /// input: no lease issuer exists, and a bearer slip is not one. An\n    /// `Effort::High` call therefore returns the engine's `LEASE_REQUIRED`\n    /// through both backends, spelled identically.\n",
          "ts": "/**\n   * Recalls a memory pack.\n   *\n   * `effort: \"high\"`, `\"xhigh\"`, or `\"max\"` is lease-gated and returns `LEASE_REQUIRED` until a\n   * lease-bearing constructor exists; this package neither mints nor\n   * simulates a lease.\n   */",
          "py": "Recalls a memory pack.\n\n        ``effort=\"high\"`` is lease-gated and raises ``LEASE_REQUIRED`` until a\n        lease-bearing constructor exists; this package neither mints nor\n        simulates a lease. ``format`` takes the engine's exact tokens:\n        ``\"json\"``, ``\"yaml\"``, ``\"toon\"``, ``\"md\"``, ``\"txt\"``.\n        "
        }
      },
      "uniffi": {
        "args": {
          "query": "String",
          "effort": "Effort",
          "scope": "Option<RecallScope>",
          "limit": "u32",
          "format": "Option<String>"
        },
        "output": "MemoryPack"
      }
    },
