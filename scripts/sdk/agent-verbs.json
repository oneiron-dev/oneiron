      "input": "RecallRequest",
      "output": "crate::memory::MemoryPack",
      "call": "memory.recall(&input.query, input.effort.unwrap_or(crate::memory::Effort::Medium), &input.scope.unwrap_or_default(), input.limit.unwrap_or(10), input.format.as_deref(), None)?",
