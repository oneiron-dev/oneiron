    {
      "name": "key_value_delete",
      "input": "crate::memory::KeyValueAddress",
      "output": "crate::memory::KeyValueDeleteReceipt",
      "call": "memory.key_value_delete(&input)?",
      "scope": "Write",
      "mcp_fields": [
        "spec"
      ],
      "admission": {},
      "mcp": "none"
    },
    {
      "name": "key_value_search",
      "input": "crate::memory::KeyValueSearch",
      "output": "Vec<crate::memory::KeyValueItem>",
      "call": "memory.key_value_search(&input)?",
      "scope": "Read",
      "mcp_fields": [
        "spec"
      ],
      "admission": {},
      "mcp": "none"
    },
    {
      "name": "key_value_namespaces",
      "input": "crate::memory::KeyValueNamespaces",
      "output": "Vec<Vec<String>>",
      "call": "memory.key_value_namespaces(&input)?",
      "scope": "Read",
      "mcp_fields": [
        "spec"
      ],
      "admission": {},
      "mcp": "none"
    },
    {
      "name": "tasks.ask",
      "input": "crate::task_verb::TaskAskSpec",
      "output": "crate::task_verb::TaskAskReceipt",
      "call": "memory.tasks_ask(&input)?",
      "scope": "Write",
      "mcp_fields": {
        "spec": "$"
      },
      "mcp": "tool-first"
    },
    {
      "name": "tasks.wait",
      "input": "TaskWaitRequest",
      "output": "crate::task_verb::TaskWaitOutcome",
      "call": "memory.tasks_wait_external(&input.handle, &input.step_key)?",
      "scope": "Write",
      "mcp_fields": {
        "task_ref": "handle.task_ref",
        "key": "step_key"
      },
      "mcp": "tool-first"
    },
    {
      "name": "tasks.answer",
      "input": "TaskAnswerRequest",
      "output": "crate::task_verb::TaskAskAnswer",
      "call": "memory.tasks_answer(&input.handle, crate::EntityId::from_hex(&input.result_ref)?)?",
      "scope": "Write",
      "mcp_fields": {
        "spec": "$"
      },
      "mcp": "tool-first"
    },
    {
      "name": "tasks.outcomes",
      "input": "crate::task_verb::TaskAskHandle",
      "output": "Vec<crate::llm::decision::questions::CalibrationPair>",
      "call": "memory.tasks_ask_outcomes(&input)?",
      "scope": "Read",
      "mcp_fields": {
        "task_ref": "task_ref"
      },
      "mcp": "tool-first"
    },
    {
      "name": "rooms.list",
      "input": "EmptyRequest",
      "output": "Vec<crate::task_verb::sdk::RoomEntry>",
      "call": "memory.rooms_list()?.into_iter().map(|(id, room)| RoomEntry { id: id.to_hex(), room }).collect::<Vec<_>>()",
      "scope": "Read",
      "mcp_fields": {},
      "mcp": "tool-first"
    },
    {
      "name": "rooms.messages",
      "input": "RoomRequest",
      "output": "crate::workspace_roster::RoomPage",
      "call": "memory.rooms_messages_page(crate::EntityId::from_hex(&input.room_ref)?, input.after.as_deref().map(crate::EntityId::from_hex).transpose()?, input.limit.unwrap_or(256))?",
      "scope": "Read",
      "mcp_fields": {
        "room_ref": "room_ref",
        "turn_ref": "after"
      },
      "mcp_required_fields": [
        "room_ref"
      ],
      "mcp": "tool-first",
      "page": {
        "rows": "rows",
        "cursor": "next_after"
      }
    },
    {
      "name": "rooms.claim",
      "input": "RoomClaimRequest",
      "output": "crate::workspace_roster::RoomClaimOutcome",
      "call": "memory.rooms_claim(crate::EntityId::from_hex(&input.room_ref)?, crate::EntityId::from_hex(&input.turn_ref)?, crate::unix_seconds_now())?",
      "scope": "Write",
      "mcp_fields": {
        "room_ref": "room_ref",
        "turn_ref": "turn_ref"
      },
      "mcp": "tool-first"
    },
    {
      "name": "rooms.speak",
      "input": "crate::memory::WitnessTurn",
      "output": "crate::memory::WitnessReceipt",
      "call": "memory.rooms_speak(&input)?",
      "scope": "Write",
      "mcp_fields": {
        "spec": "$",
        "room_ref": "=conversation_ref"
      },
      "mcp": "tool-first"
    }
  ]
}
