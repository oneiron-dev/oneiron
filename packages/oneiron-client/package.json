{
  "name": "@oneiron/client",
  "version": "0.1.0",
  "description": "The thin typed client for the Oneiron API, generated from the SDK verb table, with raw Response passthrough.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./facade": "./src/facade.ts",
    "./facade-types": "./src/facade-types.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "generate": "python3 ../../scripts/sdk/generate.py --package oneiron-client",
    "prepare": "bun run generate",
    "prepublishOnly": "bun run generate",
    "typecheck": "bun run generate && tsc --noEmit",
    "test": "bun run generate && bun test",
    "check": "bun run typecheck && bun test"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.4",
    "typescript": "5.7.3"
  }
}
