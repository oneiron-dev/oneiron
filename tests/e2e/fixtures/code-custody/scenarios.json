  "patches": {
    "good-math": {
      "path": "math.cjs",
      "before": "  return a + b;",
      "after": "  return Number(a) + Number(b);"
    },
    "overlap-guard": {
      "path": "math.cjs",
      "before": "!Number.isFinite(a) || !Number.isFinite(b)",
      "after": "![a, b].every(Number.isFinite)"
    },
    "good-label": {
      "path": "label.cjs",
      "before": "  return \"build:\" + value;",
      "after": "  return `build:${value}`;"
    },
    "bad-api": {
      "path": "math.cjs",
      "before": "module.exports = { add, increment };",
      "after": "module.exports = { add };"
    },
    "repair-api": {
      "path": "math.cjs",
      "before": "module.exports = { add };",
      "after": "module.exports = { add, increment };"
    },
    "dirty-disk": {
      "path": "math.cjs",
      "before": "  return a + b;",
      "after": "  return a - b;"
    },
    "conflict-left": {
      "path": "math.cjs",
      "before": "  return a + b;",
      "after": "  return Number(a) + Number(b);"
    },
    "conflict-right": {
      "path": "math.cjs",
      "before": "  return a + b;",
      "after": "  const sum = a + b;\n  return sum;"
    },
    "resolution": {
      "path": "math.cjs",
      "before": "  return a + b;",
      "after": "  const sum = Number(a) + Number(b);\n  return sum;"
    }
  },
  "tests": [
    {
      "id": "CODE-CUSTODY-01",
      "name": "Repository scope and pointer ingest should work",
      "surface": "HTTP + CLI",
      "setup": "Repo pointer plus tiny source tree and symbol references.",
      "steps": [
        "register repo",
        "capture snapshot",
        "search symbol neighbors",
        "read pinned version",
        "modify checkout"
      ],
      "expect": "Repo corpus is explicit scope, pointers do not imply mutable disk is truth, and snapshot search cites versioned content.",
      "source": [
        "/oneiron/code-in-oneiron/oneiron-arch-0050-repo-as-world/#tested-pointer",
        "/registry/oneiron/#OF-322",
        "/registry/oneiron/#OF-354",
        "/registry/oneiron/#OF-316"
      ],
      "rows": [
        "OF-322",
        "OF-354",
        "OF-316"
      ],
      "blocked_reason": "waits on typed repo pointer registration, snapshot capture, symbol-neighbor search and pinned source read",
      "inputs": {
        "source_root": "repo",
        "pointer_commit": "actual commit produced by the owned git client",
        "editable_whitelist": [
          "math.cjs",
          "label.cjs",
          "main.cjs"
        ],
        "symbol": "increment",
        "disk_change": "dirty-disk"
      },
      "facts": {
        "scope_kind": "repository membership on CODE artifact, not epistemic WORLD",
        "call_neighbor": "add",
        "reference_file": "main.cjs",
        "pinned_file": "math.cjs",
        "pinned_text_sha256": "d2d804dab92b13193c911bfe87409648be3f10eca81308f916fb095e18ac57b2",
        "after_disk_change": "pinned bytes and symbol citations unchanged",
        "excluded_actor": "no content, results or count hint"
      }
    },
    {
