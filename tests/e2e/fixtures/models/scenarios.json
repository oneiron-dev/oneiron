            "tier": "fixture-pinned"
          },
          "local_reasoner": {
            "model": "models-fixture/alternate@rev-a",
            "slot": "llm",
            "tier": "fixture-pinned"
          },
          "retrieval_embedder": {
            "model": "models-fixture/embedder@rev-a",
            "slot": "embedder",
            "tier": "fixture-pinned"
          },
          "extraction_encoder": {
            "model": "models-fixture/tagger@rev-a",
            "slot": "oneironer",
            "tier": "fixture-pinned"
