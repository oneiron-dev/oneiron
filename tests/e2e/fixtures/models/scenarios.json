          "{broken",
          "{\"count\":\"two\"}",
          "{\"count\":2,\"extra\":true}"
        ]
      },
      "expected": {
        "nativeAttempts": 1,
        "shimAttempts": 2,
        "exhaustedAttempts": 3,
        "untypedFallback": false,
        "silentCoercion": false
      },
      "note": "The step-layer shim/validator exists internally. Its existence does not expose a typed engine one-shot door. Do not replace this flow with agent REPL correction or ai.verdict option selection."
    },
