    {
      "id": "MODELS-03",
      "name": "One retry authority and explicit failure should work",
      "rows": [
        "OF-130",
        "OF-140"
      ],
      "source": [
        "/oneiron/agents/oneiron-arch-0026-dreamer-v2/#run-tree",
        "/oneiron/extraction/oneiron-arch-0036-model-families-v1/#model-line",
        "/registry/oneiron/#OF-130",
        "/registry/oneiron/#OF-140"
      ],
      "waitsOn": [
        "typed durable model-step submission with declared retry/fallback policy and public step receipt"
      ],
      "contract": {
        "failureClasses": [
          "Retryable",
          "Fatal",
          "BudgetDenied"
        ],
        "checkpoints": [
          "Started",
          "ResponseReceived",
          "Logged",
          "Finished"
        ]
      },
      "sequences": {
        "transient": [
          {
            "status": 503,
            "body": {
              "error": {
                "type": "server_error",
                "message": "fixture transient"
              }
            }
          },
          {
            "status": 200,
            "answer": "recovered"
          }
        ],
        "fatalWithoutFallback": [
          {
            "status": 400,
            "body": {
              "error": {
                "type": "invalid_request_error",
                "message": "fixture fatal"
              }
            }
          }
        ],
        "fatalWithDeclaredFallback": [
          {
            "status": 400,
            "body": {
              "error": {
                "type": "invalid_request_error",
                "message": "fixture fatal"
              }
            }
          }
        ],
        "exhausted": [
          503,
          503,
          503
        ]
      },
      "expected": {
        "transientAttempts": 2,
        "exhaustedAttempts": 3,
        "fatalAttempts": 1,
        "fallbackValue": {
          "outcome": "deferred",
          "reason": "provider_failed"
        },
        "undeclaredFallback": false,
        "emptyFailureSuccess": false
      },
      "note": "Three transport attempts is a fixture policy, not an engine default. Same-call offer fallback is distinct from durable-step retries; adapters must not multiply either count."
    },
