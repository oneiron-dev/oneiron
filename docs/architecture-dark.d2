direction: right

# --- Oneiron dark palette ---
# accent:  #E63E2A  (vibrant red-orange, same in both modes)
# ink:     #C8C4BA  (light text on dark)
# surface: #111111  (dark background)
# raised:  #1A1A1A  (elevated dark surface)
# success: #6BA87D  (lighter green)
# muted:   #9CA3AF  (lighter gray)
# brown:   #C4824D  (lighter warm accent)

query: Query {
  shape: text
  style.font-size: 18
  style.bold: true
  style.font-color: "#C8C4BA"
}

vault: Vault {
  style.fill: "#E63E2A"
  style.font-color: "#ffffff"
  style.stroke: "#c4321f"
  style.border-radius: 8
  style.font-size: 14
  style.bold: true
  style.shadow: true
}

vector: Vector {
  style.fill: "#1A1A1A"
  style.font-color: "#C8C4BA"
  style.stroke: "#C8C4BA"
  style.border-radius: 8
  style.font-size: 13
  style.shadow: true
}
text: Text {
  style.fill: "#1A1A1A"
  style.font-color: "#C8C4BA"
  style.stroke: "#C8C4BA"
  style.border-radius: 8
  style.font-size: 13
  style.shadow: true
}
graph: Graph {
  style.fill: "#1A1A1A"
  style.font-color: "#C8C4BA"
  style.stroke: "#C8C4BA"
  style.border-radius: 8
  style.font-size: 13
  style.shadow: true
}
temporal: Temporal {
  style.fill: "#1A1A1A"
  style.font-color: "#C8C4BA"
  style.stroke: "#C8C4BA"
  style.border-radius: 8
  style.font-size: 13
  style.shadow: true
}
phonetic: Phonetic {
  style.fill: "#1A1A1A"
  style.font-color: "#C8C4BA"
  style.stroke: "#C8C4BA"
  style.border-radius: 8
  style.font-size: 13
  style.shadow: true
}

fusion: RRF Fusion {
  style.fill: "#C8C4BA"
  style.font-color: "#111111"
  style.stroke: "#C8C4BA"
  style.border-radius: 8
  style.font-size: 14
  style.bold: true
  style.shadow: true
}

results: Results {
  shape: text
  style.font-size: 18
  style.bold: true
  style.font-color: "#6BA87D"
}

query -> vault: {style.stroke: "#E63E2A"; style.stroke-width: 2}

vault -> vector: {style.stroke: "#9CA3AF"; style.stroke-width: 2}
vault -> text: {style.stroke: "#9CA3AF"; style.stroke-width: 2}
vault -> graph: {style.stroke: "#9CA3AF"; style.stroke-width: 2}
vault -> temporal: {style.stroke: "#9CA3AF"; style.stroke-width: 2}
vault -> phonetic: {style.stroke: "#9CA3AF"; style.stroke-width: 2}

vector -> fusion: {style.stroke: "#C4824D"; style.stroke-width: 2}
text -> fusion: {style.stroke: "#C4824D"; style.stroke-width: 2}
graph -> fusion: {style.stroke: "#C4824D"; style.stroke-width: 2}
temporal -> fusion: {style.stroke: "#C4824D"; style.stroke-width: 2}
phonetic -> fusion: {style.stroke: "#C4824D"; style.stroke-width: 2}

fusion -> results: {style.stroke: "#6BA87D"; style.stroke-width: 2}
