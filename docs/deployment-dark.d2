direction: right

# --- Oneiron palette (dark) ---
# accent:  #E63E2A · ink: #C8C4BA · raised: #1E1E1E
# success: #6BA87D · muted: #9CA3AF · brown: #C4824D

core: "Oneiron\n(Rust)" {
  style.fill: "#E63E2A"
  style.font-color: "#ffffff"
  style.stroke: "#c4321f"
  style.border-radius: 8
  style.font-size: 14
  style.bold: true
  style.shadow: true
}

ffi: "C FFI · N-API" {
  style.fill: "#C8C4BA"
  style.font-color: "#111111"
  style.stroke: "#C8C4BA"
  style.border-radius: 8
  style.font-size: 13
  style.bold: true
  style.shadow: true
}

daemon: oneiron-server {
  style.fill: "#C8C4BA"
  style.font-color: "#111111"
  style.stroke: "#C8C4BA"
  style.border-radius: 8
  style.font-size: 13
  style.bold: true
  style.shadow: true
}

ios: "iOS\naarch64 · NEON" {
  style.fill: "#1E1E1E"
  style.font-color: "#ffffff"
  style.stroke: "#C8C4BA"
  style.border-radius: 8
  style.font-size: 12
  style.shadow: true
}

android: "Android\naarch64 · NEON" {
  style.fill: "#1E1E1E"
  style.font-color: "#ffffff"
  style.stroke: "#C8C4BA"
  style.border-radius: 8
  style.font-size: 12
  style.shadow: true
}

desktop: "Desktop\nAVX2 · NEON" {
  style.fill: "#1E1E1E"
  style.font-color: "#ffffff"
  style.stroke: "#C8C4BA"
  style.border-radius: 8
  style.font-size: 12
  style.shadow: true
}

node: "Node.js\nnative addon" {
  style.fill: "#1E1E1E"
  style.font-color: "#ffffff"
  style.stroke: "#C8C4BA"
  style.border-radius: 8
  style.font-size: 12
  style.shadow: true
}

local: "Local daemon\nHTTP · WS" {
  style.fill: "#1E1E1E"
  style.font-color: "#ffffff"
  style.stroke: "#C4824D"
  style.border-radius: 8
  style.font-size: 12
  style.shadow: true
}

hosted: "Hosted vault\nmanaged · wakes on demand" {
  style.fill: "#1E1E1E"
  style.font-color: "#ffffff"
  style.stroke: "#6BA87D"
  style.border-radius: 8
  style.font-size: 12
  style.shadow: true
}

core -> ffi: embed {style.stroke: "#E63E2A"; style.stroke-width: 2; style.font-color: "#C8C4BA"}
core -> daemon: run {style.stroke: "#E63E2A"; style.stroke-width: 2; style.font-color: "#C8C4BA"}

ffi -> ios: {style.stroke: "#9CA3AF"; style.stroke-width: 2}
ffi -> android: {style.stroke: "#9CA3AF"; style.stroke-width: 2}
ffi -> desktop: {style.stroke: "#9CA3AF"; style.stroke-width: 2}
ffi -> node: {style.stroke: "#9CA3AF"; style.stroke-width: 2}

daemon -> local: {style.stroke: "#C4824D"; style.stroke-width: 2}
daemon -> hosted: {style.stroke: "#6BA87D"; style.stroke-width: 2}
