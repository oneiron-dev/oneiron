direction: down

vault: LMDB Environment (18 databases) {
  style.fill: transparent
  style.stroke: "#E63E2A"
  style.border-radius: 12
  style.font-color: "#E63E2A"
  style.font-size: 16
  style.bold: true

  grid-columns: 3
  grid-gap: 16

  core: "Core" {
    shape: class
    style.fill: "#1E1E1E"
    style.stroke: "#C8C4BA"
    style.border-radius: 8
    style.font-color: "#ffffff"
    style.font-size: 13


    entities
    type_index
    short_ids
    short_ids_reverse
  }

  vector: "Vector" {
    shape: class
    style.fill: "#1E1E1E"
    style.stroke: "#E63E2A"
    style.border-radius: 8
    style.font-color: "#ffffff"
    style.font-size: 13


    vectors
    hnsw_neighbors
    hnsw_meta
  }

  text: "Text" {
    shape: class
    style.fill: "#1E1E1E"
    style.stroke: "#C4824D"
    style.border-radius: 8
    style.font-color: "#ffffff"
    style.font-size: 13


    text_postings
    text_meta
    text_forward
  }

  graph: "Graph" {
    shape: class
    style.fill: "#1E1E1E"
    style.stroke: "#6BA87D"
    style.border-radius: 8
    style.font-color: "#ffffff"
    style.font-size: 13


    edges_out
    edges_in
    ppr_cache
    ppr_cache_deps
  }

  temporal: "Temporal" {
    shape: class
    style.fill: "#1E1E1E"
    style.stroke: "#9CA3AF"
    style.border-radius: 8
    style.font-color: "#ffffff"
    style.font-size: 13


    temporal_occurred_start
    temporal_occurred_end
    temporal_learned
  }

  phonetic: "Phonetic" {
    shape: class
    style.fill: "#1E1E1E"
    style.stroke: "#C8C4BA"
    style.border-radius: 8
    style.font-color: "#ffffff"
    style.font-size: 13


    phonetic_index
  }
}
