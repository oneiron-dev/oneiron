{
  "description": "Oneiron's Claude Code hooks bind a vault at session start, recall after tool results, restore the board after compaction, and queue the session log for import before compaction, after each reply and at session end.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "oneiron hook --host claude-code session-start --credential-file \"${HOME}/.config/oneiron/claude-code-hooks.cred\" --query \" \""
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "oneiron hook --host claude-code focus-refresh --credential-file \"${HOME}/.config/oneiron/claude-code.cred\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "oneiron hook --host claude-code tool-result --credential-file \"${HOME}/.config/oneiron/claude-code-hooks.cred\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "oneiron hook --host claude-code hand-over"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "oneiron hook --host claude-code hand-over"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "oneiron hook --host claude-code hand-over --timeout 4"
          }
        ]
      }
    ]
  }
}
