{
  "description": "Oneiron's Codex hook lanes: bind a vault at session start and name it, recalling nothing there until start recall has a relevance threshold; queue the session's rollout for import before compaction, after each turn and at session end.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "oneiron hook --host codex session-start --credential-file \"$HOME/.config/oneiron/codex-hooks.cred\" --query \" \""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "oneiron hook --host codex hand-over"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "oneiron hook --host codex hand-over"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 3,
            "command": "oneiron hook --host codex hand-over --timeout 2"
          }
        ]
      }
    ]
  }
}
