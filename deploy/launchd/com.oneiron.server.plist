<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.oneiron.server</string>

  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.cargo/bin/oneiron-server</string>
    <string>serve</string>
    <string>--vault-path</string>
    <string>__HOME__/.local/share/oneiron/default</string>
  </array>

  <!-- launchd binds the daemon's socket and passes it in. The auth secret
       may live in the login keychain instead of the config file:
       security add-generic-password -s com.oneiron.server -a auth_secret -w -->
  <key>Sockets</key>
  <dict>
    <key>Listeners</key>
    <dict>
      <key>SockNodeName</key>
      <string>127.0.0.1</string>
      <key>SockServiceName</key>
      <string>9090</string>
    </dict>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/oneiron-server.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/oneiron-server.err.log</string>
</dict>
</plist>
