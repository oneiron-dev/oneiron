<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.oneiron.server</string>

  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.cargo/bin/oneiron-server</string>
    <string>serve</string>
    <string>--vault-path</string>
    <string>__HOME__/.local/share/oneiron/default</string>
    <string>--config</string>
    <string>__HOME__/.config/oneiron/oneiron.toml</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/oneiron-server.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/oneiron-server.err.log</string>
</dict>
</plist>
