[Unit]
Description=Oneiron house model: llama.cpp fallback and decision-read server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=oneiron-house
Group=oneiron-house
WorkingDirectory=/opt/oneiron
EnvironmentFile=-/etc/oneiron-house.env
Environment=HF_HOME=/var/cache/oneiron-house XDG_CACHE_HOME=/var/cache/oneiron-house TORCH_EXTENSIONS_DIR=/var/cache/oneiron-house/torch_extensions
CacheDirectory=oneiron-house
CacheDirectoryMode=0700
ExecStart=/opt/oneiron/deploy/house-model/serve-llama.sh
Restart=always
RestartSec=5s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/var/lib/oneiron-house

[Install]
WantedBy=multi-user.target
