#!/bin/sh
# PID 1 of a vault VM's engine image (VAULT-VM = B; built, not yet adopted).
# Install it as /sbin/oneiron-vault-init in the read-only rootfs
# (deploy/firecracker/build.py). The VM profile's boot_args name the vault:
# oneiron.vault=<name> oneiron.owner=<hex>. The vault's own disk is the second
# drive, /dev/vdb, ext4 with its encrypt feature.
#
# This shell only mounts, then hands over to /usr/bin/oneiron-vm-init, the
# root bootstrap (FIX 6308). It takes the vault's binding and fscrypt key on
# the host's provision connection, lays out the encrypted storage
# (/vault/storage, with the data directory /vault/storage/data, and the key
# directory /vault/keys, both the vault UID's), rebuilds /etc/oneiron/vault-uids
# from the binding, makes /run/oneiron and its voice directory (FIX 2391) the
# vault UID's, and runs the engine as that UID with the flags below.
set -eu
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
mount -t tmpfs -o mode=0755 run /run
# The UID table's directory: a root-owned tmpfs over the read-only image's
# mountpoint, so the table is rebuilt from the host's binding on every cold
# boot and never persists.
mount -t tmpfs -o mode=0755,nosuid,nodev,noexec oneiron /etc/oneiron
mount -t ext4 -o noatime /dev/vdb /vault

vault=""
owner=""
allowed_origins=""
artifact_origin=""
artifact_domains=""
artifact_public_slug=""
config=""
for word in $(cat /proc/cmdline); do
  case "$word" in
    oneiron.vault=*) vault="${word#oneiron.vault=}" ;;
    oneiron.owner=*) owner="${word#oneiron.owner=}" ;;
    oneiron.allowed_origins=*) allowed_origins="${word#oneiron.allowed_origins=}" ;;
    oneiron.artifact_origin=*) artifact_origin="${word#oneiron.artifact_origin=}" ;;
    oneiron.artifact_domains=*) artifact_domains="${word#oneiron.artifact_domains=}" ;;
    oneiron.artifact_public_slug=*) artifact_public_slug="${word#oneiron.artifact_public_slug=}" ;;
    oneiron.config=*) config="${word#oneiron.config=}" ;;
  esac
done

set --
if [ -n "$allowed_origins" ]; then
  set -- --allowed-origins "$allowed_origins"
fi
# The artifact origin, reached on vsock port 1028 (OF-356), at the vault's
# public slug, never its vault name (FIX 5389).
if [ "$artifact_origin" = "1" ]; then
  set -- "$@" --artifact-http-socket /run/oneiron/artifacts.sock
  if [ -n "$artifact_domains" ]; then
    set -- "$@" --artifact-domains "$artifact_domains"
  fi
  if [ -n "$artifact_public_slug" ]; then
    set -- "$@" --artifact-public-slug "$artifact_public_slug"
  fi
fi

# The vault's managed settings, on the read-only third drive (/dev/vdc) when
# the VM profile names a config_disk: each file present becomes its flag.
# settings.toml is the owner's settings in the server's config schema; the
# files its paths name sit beside it or under /vault/storage/data (the
# contract's VM_GUEST_CONFIG_DIR and VM_GUEST_DATA_DIR, the --data-dir that
# oneiron-vm-init passes).
if [ "$config" = "1" ]; then
  mkdir -p /config
  mount -t ext4 -o ro,noatime /dev/vdc /config
  if [ -f /config/settings.toml ]; then
    set -- "$@" --settings-file /config/settings.toml
  fi
  for pair in key:--seal-key-file chain:--seal-chain-file trust:--seal-trust-file; do
    if [ -f "/config/seal/${pair%%:*}.pem" ]; then
      set -- "$@" "${pair#*:}" "/config/seal/${pair%%:*}.pem"
    fi
  done
  if [ -f /config/seal/organ ]; then
    set -- "$@" --seal-organ /config/seal/organ
  fi
  if [ -f /config/seal/tsa-url ]; then
    set -- "$@" --seal-tsa-url "$(head -n 1 /config/seal/tsa-url)"
  fi
  if [ -f /config/seal/signing-url ]; then
    set -- "$@" --seal-signing-url "$(head -n 1 /config/seal/signing-url)"
  fi
  # The host's public addresses, which the supervisor owns: its https origin,
  # and the comma-separated URLs a recovery kit dials.
  for flag in oauth-resource-indicator kit-bundle-public-urls; do
    if [ -f "/config/$flag" ]; then
      set -- "$@" "--$flag" "$(head -n 1 "/config/$flag")"
    fi
  done
  # The supervisor's bindings for the guests' container CLIs (paths in this
  # rootfs) and the mesh listener's bind and comma-separated relays.
  for flag in browser-runtime desktop-runtime mesh-bind mesh-relays; do
    if [ -f "/config/$flag" ]; then
      set -- "$@" "--$flag" "$(head -n 1 "/config/$flag")"
    fi
  done
fi

# The provision prelude, the credential frame and the ready byte ride the
# vsock boot port; the host reaches HTTP and ctl through vsock ports the
# engine bridges onto these paths. oneiron-vm-init refuses the boot when the
# host's binding names another vault or owner than these boot arguments, and
# itself passes the engine its vault, owner, --data-dir and --keystore-dir.
/usr/bin/oneiron-vm-init --vault-name "$vault" --derivation-owner "$owner" -- \
  --voice-socket /run/oneiron/voice/voice.sock \
  --http-socket /run/oneiron/http.sock \
  --ctl-socket /run/oneiron/ctl.sock \
  --hypnos-socket /run/oneiron/hypnos.sock "$@" || true

# The engine has drained and flushed, and oneiron-vm-init removed the
# vault's key. Ending PID 1 ends the VM.
sync
umount /config 2>/dev/null || true
umount /vault || true
reboot -f
