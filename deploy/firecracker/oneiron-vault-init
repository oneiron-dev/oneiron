#!/bin/sh
# PID 1 of a vault VM's engine image (VAULT-VM = B; built, not yet adopted).
# Install it as /sbin/oneiron-vault-init in the read-only rootfs. The VM
# profile's boot_args name the vault: oneiron.vault=<name> oneiron.owner=<hex>.
# The vault's own disk is the second drive, /dev/vdb, formatted ext4.
set -eu
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
mount -t tmpfs -o mode=0755 run /run
mkdir -p /run/oneiron /vault
# The voice loop's socket directory: --voice-socket lies in it, and it must be
# owner-only (FIX 2391).
mkdir -p -m 0700 /run/oneiron/voice
mount -t ext4 -o noatime /dev/vdb /vault
# This install's key slots: on the vault's own disk, so they outlive the VM,
# and outside its data directory, /config and /run.
mkdir -p -m 0700 /vault/keys

vault=""
owner=""
allowed_origins=""
artifact_origin=""
artifact_domains=""
config=""
for word in $(cat /proc/cmdline); do
  case "$word" in
    oneiron.vault=*) vault="${word#oneiron.vault=}" ;;
    oneiron.owner=*) owner="${word#oneiron.owner=}" ;;
    oneiron.allowed_origins=*) allowed_origins="${word#oneiron.allowed_origins=}" ;;
    oneiron.artifact_origin=*) artifact_origin="${word#oneiron.artifact_origin=}" ;;
    oneiron.artifact_domains=*) artifact_domains="${word#oneiron.artifact_domains=}" ;;
    oneiron.config=*) config="${word#oneiron.config=}" ;;
  esac
done

set --
if [ -n "$allowed_origins" ]; then
  set -- --allowed-origins "$allowed_origins"
fi
# The artifact origin, reached on vsock port 1028 (OF-356).
if [ "$artifact_origin" = "1" ]; then
  set -- "$@" --artifact-http-socket /run/oneiron/artifacts.sock
  if [ -n "$artifact_domains" ]; then
    set -- "$@" --artifact-domains "$artifact_domains"
  fi
fi

# The vault's managed settings, on the read-only third drive (/dev/vdc) when
# the VM profile names a config_disk: each file present becomes its flag.
# settings.toml is the owner's settings in the server's config schema; the
# files its paths name sit beside it or under /vault/data.
if [ "$config" = "1" ]; then
  mkdir -p /config
  mount -t ext4 -o ro,noatime /dev/vdc /config
  if [ -f /config/settings.toml ]; then
    set -- "$@" --settings-file /config/settings.toml
  fi
  for pair in key:--seal-key-file chain:--seal-chain-file trust:--seal-trust-file; do
    if [ -f "/config/seal/${pair%%:*}.pem" ]; then
      set -- "$@" "${pair#*:}" "/config/seal/${pair%%:*}.pem"
    fi
  done
  if [ -f /config/seal/organ ]; then
    set -- "$@" --seal-organ /config/seal/organ
  fi
  if [ -f /config/seal/tsa-url ]; then
    set -- "$@" --seal-tsa-url "$(head -n 1 /config/seal/tsa-url)"
  fi
  if [ -f /config/seal/signing-url ]; then
    set -- "$@" --seal-signing-url "$(head -n 1 /config/seal/signing-url)"
  fi
  # The host's public addresses, which the supervisor owns: its https origin,
  # and the comma-separated URLs a recovery kit dials.
  for flag in oauth-resource-indicator kit-bundle-public-urls; do
    if [ -f "/config/$flag" ]; then
      set -- "$@" "--$flag" "$(head -n 1 "/config/$flag")"
    fi
  done
  # The supervisor's bindings for the guests' container CLIs (paths in this
  # rootfs) and the mesh listener's bind and comma-separated relays.
  for flag in browser-runtime desktop-runtime mesh-bind mesh-relays; do
    if [ -f "/config/$flag" ]; then
      set -- "$@" "--$flag" "$(head -n 1 "/config/$flag")"
    fi
  done
fi

# The credential frame and the ready byte ride the vsock boot port; the host
# reaches HTTP and ctl through vsock ports the engine bridges onto these paths.
/usr/bin/oneiron-server serve --managed-by-hypnos --vsock-guest \
  --contract-version 3 \
  --vault-name "$vault" \
  --derivation-owner "$owner" \
  --data-dir /vault/data \
  --keystore-dir /vault/keys \
  --voice-socket /run/oneiron/voice/voice.sock \
  --http-socket /run/oneiron/http.sock \
  --ctl-socket /run/oneiron/ctl.sock \
  --hypnos-socket /run/oneiron/hypnos.sock "$@" || true

# The engine has drained and flushed. Ending PID 1 ends the VM.
sync
umount /config 2>/dev/null || true
umount /vault || true
reboot -f
