# The vault VM's kernel fragment (deploy/firecracker/build.py kernel): built-in
# drivers, no initramfs or modules. Beyond the code-run guest's set
# (scripts/microvm/kernel.config) it carries what the vault's provisioning
# needs (FIX 6308): fscrypt v2 on ext4 with AES-256-XTS contents, AES-256-CTS
# names and HKDF-SHA512 key derivation, the keyring the key goes into, and
# real users for the engine's UID drop. It also carries the virtio network
# card a host may attach for the guest's outbound IPv4 (FIX 6808); routing,
# masquerade and the firewall are the host's, so the guest needs no netfilter
# or NAT. And it carries what the guests' rootless container runtime needs
# (FIX 7671): the namespaces the vault UID's container CLI makes, and cgroup
# v2's cpu controller with its bandwidth limit beside memory and pids, for
# the guests' --cpus, --memory and --pids-limit. The exact symbol closure
# depends on the pinned kernel release: build.py refuses a config that did
# not keep every line here and records the resolved config's hash in its
# receipt.
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_MODULES=n
CONFIG_MULTIUSER=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_BLK=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
CONFIG_UNIX=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS_COMMON=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
# CONFIG_DEVTMPFS_MOUNT is not set
CONFIG_EXT4_FS=y
CONFIG_KEYS=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_ALGS=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_CTS=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_OVERLAY_FS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="landlock"
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_TIMERFD=y
CONFIG_INOTIFY_USER=y
CONFIG_DEBUG_INFO_NONE=y
CONFIG_WERROR=n
