# /etc/oneiron-house.env: read by both house-model units. Every key is
# optional; the values below are the defaults the serve scripts use.
ONEIRON_HOUSE_PYTHON=/opt/oneiron-house/.venv/bin/python
ONEIRON_HOUSE_EXL3_TARGET=/var/lib/oneiron-house/models/qwen3.8-27b-exl3-4bpw
ONEIRON_HOUSE_EXL3_DRAFT=/var/lib/oneiron-house/models/qwen3.8-27b-dflash2-exl3-5bpw
# The EXL3 target's weights manifest, written when the weights are deployed
# (`weights_manifest.py prepare`). Missing or mismatched, the server still
# serves, with no weights digest in its cache identity.
ONEIRON_HOUSE_EXL3_WEIGHTS_MANIFEST=/var/lib/oneiron-house/models/qwen3.8-27b-exl3-4bpw.weights.json
# Owner ruling 2026-10-16: depth 7 for every workload, until new evidence.
ONEIRON_HOUSE_DRAFT_DEPTH=7
ONEIRON_HOUSE_EXL3_GPU=0
ONEIRON_HOUSE_EXL3_PORT=18091
# Requests the EXL3 scheduler runs at once (1..4); a request that sets
# `oneiron_solo` runs alone.
ONEIRON_HOUSE_EXL3_IN_FLIGHT=4
# Shared KV pool in tokens: a page multiple, at least one full request (the
# context + 1 + the draft depth + 16, rounded up to 256); unset, the server's
# DEFAULT_CACHE_TOKENS (40192), or that floor when it is larger (33024 at these
# values).
# ONEIRON_HOUSE_EXL3_CACHE_TOKENS=40192
# Built by build-llama.sh at llama.cpp d81235049384534c167caea52b85a694f6103d14,
# with llama-server.build.json beside it.
ONEIRON_HOUSE_LLAMA_SERVER=/opt/oneiron-house/llama.cpp/build/bin/llama-server
ONEIRON_HOUSE_LLAMA_TARGET=/var/lib/oneiron-house/models/Qwen3.8-27B-UD-Q4_K_M.gguf
ONEIRON_HOUSE_LLAMA_DRAFT=/var/lib/oneiron-house/models/Qwen3.5-0.8B-Q8_0.gguf
ONEIRON_HOUSE_LLAMA_DRAFT_MAX=8
ONEIRON_HOUSE_LLAMA_SLOTS=2
ONEIRON_HOUSE_LLAMA_GPU=1
ONEIRON_HOUSE_LLAMA_PORT=18134
# The configured wire id the llama provider sends (models.toml): each launch's
# identity manifest is bound to it. The manifests-only directory each launch
# writes its manifest to and llama-server serves at its root (`--path`).
ONEIRON_HOUSE_LLAMA_MODEL_ID=qwen3.8-27b
ONEIRON_HOUSE_LLAMA_IDENTITY_DIR=/var/cache/oneiron-house/llama-identity
ONEIRON_HOUSE_CONTEXT=32768
