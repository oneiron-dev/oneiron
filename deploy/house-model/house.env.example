# /etc/oneiron-house.env: read by both house-model units. Every key is
# optional; the values below are the defaults the serve scripts use.
ONEIRON_HOUSE_PYTHON=/opt/oneiron-house/.venv/bin/python
ONEIRON_HOUSE_EXL3_TARGET=/var/lib/oneiron-house/models/qwen3.8-27b-exl3-4bpw
ONEIRON_HOUSE_EXL3_DRAFT=/var/lib/oneiron-house/models/qwen3.8-27b-dflash2-exl3-5bpw
# Owner ruling 2026-10-16: depth 7 for every workload, until new evidence.
ONEIRON_HOUSE_DRAFT_DEPTH=7
ONEIRON_HOUSE_EXL3_GPU=0
ONEIRON_HOUSE_EXL3_PORT=18091
# Requests the EXL3 scheduler runs at once (1..4); stays 1 until E5 and E1 pass.
ONEIRON_HOUSE_EXL3_IN_FLIGHT=1
# Shared KV pool in tokens: a page multiple, at least one full request; unset,
# it is the context + 1 + the draft depth + 16, rounded up to 256.
# ONEIRON_HOUSE_EXL3_CACHE_TOKENS=33024
ONEIRON_HOUSE_LLAMA_SERVER=/opt/oneiron-house/llama.cpp/build/bin/llama-server
ONEIRON_HOUSE_LLAMA_TARGET=/var/lib/oneiron-house/models/Qwen3.8-27B-UD-Q4_K_M.gguf
ONEIRON_HOUSE_LLAMA_DRAFT=/var/lib/oneiron-house/models/Qwen3.5-0.8B-Q8_0.gguf
ONEIRON_HOUSE_LLAMA_DRAFT_MAX=8
ONEIRON_HOUSE_LLAMA_SLOTS=2
ONEIRON_HOUSE_LLAMA_GPU=1
ONEIRON_HOUSE_LLAMA_PORT=18134
ONEIRON_HOUSE_CONTEXT=32768
